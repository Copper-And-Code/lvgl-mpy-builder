exports[`reference project snapshots (unix, bundled templates) > MicroPython 1`] = `
""""
Auto-generated LVGL UI Code for MicroPython (Multi-Page)
Project: Demo & Co
Generated: 2026-01-01T00:00:00.000Z
Pages: 1
Target: Unix/Linux

LVGL Version: 9.3 (lv_micropython binding)

This is a customizable template file for multi-page projects.
You can modify this file to change the structure of the generated code.
"""

import lvgl as lv

# Created widgets, by name (e.g. objects["ok_button"])
objects = {}


# Event callback implementations
def on_ok(e):
    """Event handler (see the branches below for the handled events)"""
    code = e.get_code()
    obj = e.get_target_obj()

    if code == lv.EVENT.CLICKED:
        if count > 0 and count < 10:
            count = count + 1
        print("a & b")
        pass

# Screen objects for each page
screens = [None] * 1
current_screen = 0

def demo_co_create_main(parent=None):
    """
    Create page: Main
    Size: 480x320
    Widgets: 3
    """
    if parent is None:
        parent = lv.screen_active()

    # panel: panel_main
    panel_main = lv.obj(parent)
    objects["panel_main"] = panel_main
    panel_main.set_pos(10, 10)
    panel_main.set_size(200, 100)

    # label: title
    title = lv.label(panel_main)
    objects["title"] = title
    title.set_pos(5, 5)
    title.set_size(100, 20)
    title.set_text("Hello")

    # button: ok_button
    ok_button = lv.button(parent)
    objects["ok_button"] = ok_button
    ok_button.set_pos(20, 150)
    ok_button.set_size(80, 40)
    ok_button_label = lv.label(ok_button)
    ok_button_label.set_text("OK")
    ok_button_label.center()
    ok_button.add_event_cb(on_ok, lv.EVENT.CLICKED, None)
    ok_button_anim = lv.anim_t()
    ok_button_anim.init()
    ok_button_anim.set_var(ok_button)
    ok_button_anim.set_values(0, 100)
    ok_button_anim.set_duration(500)
    ok_button_anim.set_path_cb(lv.anim_t.path_linear)
    ok_button_anim.set_custom_exec_cb(lambda _anim, value: ok_button.set_x(value))
    ok_button_anim.start()


def demo_co_load_page(page_index):
    """
    Load a specific page by index

    Args:
        page_index: Index of the page to load (0-0)
    """
    global screens, current_screen

    if page_index < 0 or page_index >= 1:
        return

    if screens[page_index] is None:
        screens[page_index] = lv.obj()

        # Create the page based on index
        if page_index == 0:
            demo_co_create_main(screens[0])

    lv.screen_load(screens[page_index])
    current_screen = page_index

def demo_co_load_page_anim(page_index, anim, time_ms, delay_ms):
    """Load page with animation"""
    global screens, current_screen

    if page_index < 0 or page_index >= 1:
        return

    if screens[page_index] is None:
        screens[page_index] = lv.obj()

        if page_index == 0:
            demo_co_create_main(screens[0])

    lv.screen_load_anim(screens[page_index], anim, time_ms, delay_ms, False)
    current_screen = page_index

def demo_co_get_current_page():
    """Get current page index"""
    return current_screen

def demo_co_init():
    """
    Initialize all screens and show the first page
    """
    global screens, current_screen

    # Initialize screen array
    screens = [None] * 1
    current_screen = 0

    # Load first page
    demo_co_load_page(0)

# Example usage:
# demo_co_init()
# demo_co_load_page(1)  # Switch to page 1
"
