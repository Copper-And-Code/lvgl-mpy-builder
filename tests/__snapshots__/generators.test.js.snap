"/*
 * Auto-generated LVGL UI Code (Multi-Page)
 * Project: Demo & Co
 * Generated: 2026-01-01T00:00:00.000Z
 * Pages: 1
 *
 * LVGL Version: 9.6 (no deprecated APIs)
 * Target: Unix/Linux
 *
 * This is a customizable template file for multi-page projects.
 */

#include "lvgl.h"

/* Widget handles (use \`extern lv_obj_t * ui_<name>;\` to access them from other files) */
lv_obj_t * ui_panel_main;
lv_obj_t * ui_title;
lv_obj_t * ui_ok_button;


/* Event callback declarations */
static void on_ok(lv_event_t *e);

/* Screen objects for each page */
static lv_obj_t *screens[1];
static int current_screen = 0;

/**
 * Create page: Main
 * Size: 480x320
 * Widgets: 3
 */
void demo_co_create_main(lv_obj_t *parent)
{
    if (parent == NULL) {
        parent = lv_screen_active();
    }

    /* panel: panel_main */
    ui_panel_main = lv_obj_create(parent);
    lv_obj_set_pos(ui_panel_main, 10, 10);
    lv_obj_set_size(ui_panel_main, 200, 100);

    /* label: title */
    ui_title = lv_label_create(ui_panel_main);
    lv_obj_set_pos(ui_title, 5, 5);
    lv_obj_set_size(ui_title, 100, 20);
    lv_label_set_text(ui_title, "Hello");

    /* button: ok_button */
    ui_ok_button = lv_button_create(parent);
    lv_obj_set_pos(ui_ok_button, 20, 150);
    lv_obj_set_size(ui_ok_button, 80, 40);
    lv_obj_t * ok_button_label = lv_label_create(ui_ok_button);
    lv_label_set_text(ok_button_label, "OK");
    lv_obj_center(ok_button_label);
    lv_obj_add_event_cb(ui_ok_button, on_ok, LV_EVENT_CLICKED, NULL);
    lv_anim_t ok_button_anim;
    lv_anim_init(&ok_button_anim);
    lv_anim_set_var(&ok_button_anim, ui_ok_button);
    lv_anim_set_values(&ok_button_anim, 0, 100);
    lv_anim_set_duration(&ok_button_anim, 500);
    lv_anim_set_path_cb(&ok_button_anim, lv_anim_path_linear);
    lv_anim_set_exec_cb(&ok_button_anim, (lv_anim_exec_xcb_t)lv_obj_set_x);
    lv_anim_start(&ok_button_anim);

}

/* Event callback implementations */
static void on_ok(lv_event_t *e)
{
    lv_event_code_t code = lv_event_get_code(e);
    lv_obj_t *obj = lv_event_get_target_obj(e);
    LV_UNUSED(obj);

    if (code == LV_EVENT_CLICKED) {
        if count > 0 and count < 10:
            count = count + 1
        print("a & b")
    }
}

/**
 * Load a specific page by index
 * @param page_index Index of the page to load (0-0)
 */
void demo_co_load_page(int page_index)
{
    if (page_index < 0 || page_index >= 1) {
        return;
    }

    if (screens[page_index] == NULL) {
        screens[page_index] = lv_obj_create(NULL);

        switch(page_index) {
            case 0:
                demo_co_create_main(screens[0]);
                break;
        }
    }

    lv_screen_load(screens[page_index]);
    current_screen = page_index;
}

/**
 * Load page with animation
 */
void demo_co_load_page_anim(int page_index, lv_screen_load_anim_t anim, uint32_t time, uint32_t delay)
{
    if (page_index < 0 || page_index >= 1) {
        return;
    }

    if (screens[page_index] == NULL) {
        screens[page_index] = lv_obj_create(NULL);

        switch(page_index) {
            case 0:
                demo_co_create_main(screens[0]);
                break;
        }
    }

    lv_screen_load_anim(screens[page_index], anim, time, delay, false);
    current_screen = page_index;
}

/**
 * Get current page index
 */
int demo_co_get_current_page(void)
{
    return current_screen;
}

/**
 * Initialize all screens and show the first page
 */
void demo_co_init(void)
{
    for (int i = 0; i < 1; i++) {
        screens[i] = NULL;
    }

    demo_co_load_page(0);
}
"
