    lv_anim_set_var(&ok_button_anim_0001, ok_button);
    lv_anim_set_time(&ok_button_anim_0001, 500);
    lv_anim_set_delay(&ok_button_anim_0001, 0);
    lv_anim_set_values(&ok_button_anim_0001, 0, 100);
    lv_anim_set_path_cb(&ok_button_anim_0001, lv_anim_path_linear);
    lv_anim_set_exec_cb(&ok_button_anim_0001, (lv_anim_exec_xcb_t)lv_obj_set_x);
    lv_anim_start(&ok_button_anim_0001);

    /* Create label: title */
    lv_obj_t *title = lv_label_create(panel_main);
    lv_obj_set_pos(title, 5, 5);
    lv_obj_set_size(title, 100, 20);
    lv_label_set_text(title, "Hello");

}

