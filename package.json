{
  "name": "lvgl-editor",
  "version": "2.0.0",
  "description": "Visual editor for LVGL with C and MicroPython code generation",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "dev": "concurrently \"npm run dev:renderer\" \"wait-on http://localhost:3000 && NODE_ENV=development electron .\"",
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "lint": "eslint src --ext js,jsx --report-unused-disable-directives --max-warnings 0"
  },
  "keywords": ["lvgl", "editor", "gui", "embedded", "micropython"],
  "author": "LVGL Community",
  "license": "MIT",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "konva": "^9.3.0",
    "react-konva": "^18.2.10",
    "handlebars": "^4.7.8",
    "zustand": "^4.4.7",
    "uuid": "^9.0.1",
    "lucide-react": "^0.294.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^28.0.0",
    "electron-forge": "^5.2.4",
    "vite": "^5.0.8",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2"
  }
}
