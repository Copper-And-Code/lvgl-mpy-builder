{
    if (page_index < 0 || page_index >= {{pageCount}}) {
        return;
    }

    if (screens[page_index] == NULL) {
        screens[page_index] = lv_obj_create(NULL);

        switch(page_index) {
{{#each pages}}
            case {{@index}}:
                {{this.functionName}}(screens[{{@index}}]);
                break;
{{/each}}
